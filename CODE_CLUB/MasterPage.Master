<%@ Master Language="C#" AutoEventWireup="true" CodeFile="MasterPage.master.cs" Inherits="CODE_CLUB.MasterPage" %>

<!DOCTYPE html>

<html lang="en">
<head runat="server">
     <meta charset="UTF-8" />
 <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>CodeClub — <asp:ContentPlaceHolder ID="PageTitle" runat="server">Portfolio</asp:ContentPlaceHolder></title>
    <link rel="stylesheet" href="~/Styles/clubStyle.css" />
     <link href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=Syne:wght@400;600;800&display=swap" rel="stylesheet" />
    <asp:ContentPlaceHolder ID="HeadContent" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
     <aside class="sidebar" id="sidebar">
   <div class="sidebar-logo">
     <span class="logo-icon">&lt;/&gt;</span>
     <span class="logo-text">CodeClub</span>
   </div>

   <button class="menu-toggle" id="menuToggle">
     <span></span><span></span><span></span>
   </button>

   <nav class="sidebar-nav">
     <ul>
       <li><a href="~/Pages/Default.aspx"   runat="server" class="nav-link"><span class="nav-icon">⌂</span> Home</a></li>
       <li><a href="~/Pages/About.aspx"     runat="server" class="nav-link"><span class="nav-icon">◈</span> About</a></li>
       <li><a href="~/Pages/Projects.aspx"  runat="server" class="nav-link"><span class="nav-icon">⬡</span> Projects</a></li>
       <li><a href="~/Pages/Events.aspx"    runat="server" class="nav-link"><span class="nav-icon">◷</span> Events</a></li>
       <li><a href="~/Pages/Members.aspx"   runat="server" class="nav-link"><span class="nav-icon">◉</span> Members</a></li>
       <li><a href="~/Pages/Contact.aspx"   runat="server" class="nav-link"><span class="nav-icon">◎</span> Contact</a></li>
       <li><a href="~/Pages/Feedback.aspx"  runat="server" class="nav-link"><span class="nav-icon">◌</span> Feedback</a></li>

         <% if (SessionManager.IsMemberLoggedIn()) { %>
          <li class="nav-member-info">
            <span class="nav-icon">✦</span>
            Hi, <strong><%= SessionManager.GetMemberName() %></strong>
          </li>
          <li>
               <a href="~/Pages/MemberLogout.aspx" runat="server" class="nav-link nav-logout">
              <span class="nav-icon">⇤</span> Logout
            </a>
          </li>
        <% } else { %>
          <li><a href="~/Pages/Join.aspx"  runat="server" class="nav-link"><span class="nav-icon">✦</span> Join Us</a></li>
          <li><a href="~/Pages/Login.aspx" runat="server" class="nav-link"><span class="nav-icon">⚿</span> Login</a></li>
        <% } %>


         </ul>
       </nav>

          <% if (SessionManager.IsAdminLoggedIn()) { %>
    <div class="admin-badge">
      <span>⚙</span> Admin: <%= SessionManager.GetAdminName() %>
      <a href="~/Pages/Admin/Dashboard.aspx" runat="server">Dashboard</a>
    </div>
    <% } %>

    <div class="sidebar-footer">
      <p>© 2025 CodeClub</p>
    </div>
         </aside>

     <main class="main-content">
   <asp:ContentPlaceHolder ID="MainContent" runat="server" />
 </main>
     <div class="toast" id="toast"></div>

 <script src="~/Scripts/script.js" runat="server"></script>

</body>
</html>
